# Copy this file to .env and fill in your own keys.
# .env is gitignored. Never commit real keys.

# ----- OpenAI / Claude / Gemini (via OpenAI-compatible proxies) -----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
OPENAI_TIMEOUT_SECONDS=900
OPENAI_TRUST_ENV=false

# ----- Aliyun DashScope (Qwen closed) -----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3-vl-plus

# ----- SiliconFlow (Qwen open / Qwen3.5-397B-A17B etc.) -----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
QWEN_OPEN_API_KEY=
QWEN_OPEN_BASE_URL=
QWEN_OPEN_MODEL_NAME=Qwen/Qwen3.5-397B-A17B

# ----- GLM / Step / Kimi (used by VOI) -----
GLM_API_KEY=
GLM_BASE_URL=
STEP_API_KEY=
STEP_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=

# ----- Per-task evaluation tuning -----
EVAL_TRANSIENT_RETRY_ATTEMPTS=3
EVAL_TRANSIENT_RETRY_BASE_DELAY_SECONDS=2
EVAL_TRANSIENT_RETRY_MAX_DELAY_SECONDS=120
CTR_EVAL_THINKING_ENABLED=true
