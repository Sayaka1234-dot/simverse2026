{
    "name": "ctr-game",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/compressJson.js",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "eval:batch": "tsx scripts/eval-batch.ts",
        "eval:browser-batch": "node scripts/eval-browser-batch.mjs",
        "capture:levels": "set TS_NODE_TRANSPILE_ONLY=1 && node --loader ./scripts/ts-node-alias-loader.mjs scripts/capture-level-images-node.ts",
        "capture:videos": "node scripts/capture-level-videos.mjs",
        "convert:videos:mp4": "node scripts/convert-level-videos-to-mp4.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@napi-rs/canvas": "^0.1.97",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@types/node": "^24.10.0",
        "eslint": "^9.39.1",
        "globals": "^16.4.0",
        "playwright": "^1.58.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.19.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3",
        "vite": "npm:rolldown-vite@7.1.19",
        "vite-plugin-pwa": "^1.1.0"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.1.19"
    },
    "dependencies": {
        "prettier": "^3.6.2"
    }
}
